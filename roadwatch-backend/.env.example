# ==============================================================================
# RoadWatch Backend Environment Variables
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB Configuration
# Local URI: mongodb://localhost:27017/roadwatch
# Atlas URI: mongodb+srv://<user>:<password>@cluster0.mongodb.net/roadwatch?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/roadwatch

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_roadwatch_production_grade_32_characters_minimum
JWT_EXPIRE=7d

# Cloudinary Storage Configuration
# Sign up free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz123456
CLOUDINARY_FOLDER=roadwatch

# Cron Settings
OVERDUE_CRON_SCHEDULE=0 * * * *

